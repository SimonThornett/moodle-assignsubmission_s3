{{!
    @template assignsubmission_s3/form/file

    File input and upload progress for S3 assignment submissions.

    Classes required for JS:
    * progress-bar
    * progress-bar-container

    Context variables required for this template:
    * accept - (optional) Comma-separated accepted file extensions or MIME types
    * humansize - Human-readable maximum file size
    * multiple - Whether multiple files can be selected
    * maxfiles - Maximum number of files
    * acceptedtypes - Accepted file types label
    * maxfilesize - Maximum file size label
    * maxfileslabel - Maximum number of files label

    Example context (json):
    {
        "accept": ".pdf,.txt",
        "humansize": "4 GB",
        "multiple": true,
        "maxfiles": 3,
        "acceptedtypes": "Accepted file types:",
        "maxfilesize": "Maximum file size:",
        "maxfileslabel": "Maximum number of files:"
    }

}}
<div id="s3-file-container" class="mb-3 row fitem">
    <div class="col-md-3 d-flex pb-0 pe-md-0 pl-5">
        <p id="id_s3_file_label" class="mb-0 d-inline" aria-hidden="true" style="cursor: default;">
            S3 submission
        </p>
    </div>
    <div class="col-md-9 d-flex flex-wrap align-items-start felement" data-fieldtype="filemanager">
        <fieldset class="w-100 m-0 p-0 border-0" id="id_s3_file_fieldset">
            <input type="file" id="s3_file" name="s3_file"{{#accept}} accept="{{accept}}"{{/accept}}{{#multiple}} multiple{{/multiple}}>
            <div>{{acceptedtypes}} {{accept}}</div>
            <div>{{maxfilesize}} {{humansize}}</div>
            <div>{{maxfileslabel}} {{maxfiles}}</div>
        </fieldset>
    </div>
</div>
<div id="progress-bar-container" class="container progress-bar-container hidden pb-3 pt-3">
    <span id="progress-bar-percent">0%</span>
    <div class="progress" style="height: 20px;">
        <div id="progress-bar" class="progress-bar" role="progressbar" aria-labelledby="id_s3_file_label"
             aria-describedby="progress-bar-percent" aria-valuenow="0" aria-valuemin="0" aria-valuemax="100"></div>
    </div>
</div>